{
  "name": "titan-xt-app",
  "version": "2.4.0",
  "description": "Titan-XT Remote Desktop App",
  "author": "xtapo",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run watch:main\" \"npm run dev:renderer\" \"npm run start:electron\"",
    "build:main": "tsc -p tsconfig.main.json",
    "watch:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "vite",
    "start:electron": "electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "release:draft": "npm run build && electron-builder --publish onTagOrDraft"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "adm-zip": "^0.5.17",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "koffi": "^2.16.2",
    "node-machine-id": "^1.1.12",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.titanxt.app",
    "productName": "Titan-XT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "xtapo",
      "repo": "Titan-XT"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "resources/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Titan-XT cần camera để hỗ trợ phiên gọi video (nếu bật).",
        "NSMicrophoneUsageDescription": "Titan-XT cần micro để truyền âm thanh trong phiên hỗ trợ.",
        "NSScreenCaptureUsageDescription": "Titan-XT cần quyền ghi màn hình để chia sẻ màn hình với kỹ thuật viên.",
        "NSAppleEventsUsageDescription": "Titan-XT dùng AppleScript để khởi động lại / tắt máy / đăng xuất khi được yêu cầu từ xa.",
        "NSAccessibilityUsageDescription": "Titan-XT cần quyền Accessibility để mô phỏng chuột và bàn phím từ xa."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    }
  }
}

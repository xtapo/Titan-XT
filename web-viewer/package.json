{
  "name": "titan-xt-web-viewer",
  "version": "1.3.0",
  "description": "Mobile/PWA viewer for Titan-XT — connect to a Titan-XT host from a browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
